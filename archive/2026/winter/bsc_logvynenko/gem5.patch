+  //   parked V__C__P (present)                 -> InvCache drops V__C__P
+  //     (i_invL2), so drop the copy from the backing too and unregister it.
+  // The DROP reuses CoherenceRequestType:InvCache toward the backing and is
+  // fire-and-forget (no data, no response). Ordering on the per-address backing
+  // link keeps it from racing a later re-park of the same address.
+  action(ipb_invParkedBacking, "ipb", desc="InvCache on a parked line: drop present-class from backing") {
+    assert(parkedTags.isTagPresent(address));
+    Entry pe := static_cast(Entry, "pointer", parkedTags.lookup(address));
