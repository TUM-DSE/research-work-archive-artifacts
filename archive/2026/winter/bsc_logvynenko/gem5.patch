diff --git a/src/mem/ruby/protocol/BackingCache.sm b/src/mem/ruby/protocol/BackingCache.sm
new file mode 100644
index 0000000000..ae694076dc
--- /dev/null
+++ b/src/mem/ruby/protocol/BackingCache.sm
@@ -0,0 +1,324 @@
+/*
+ * BackingCache.sm
+ *
+ * A single, self-contained tagged cache (tag = original CXL address) that
+ * TCC evictions are parked into instead of being written back to the
+ * (simulated CXL) main memory. There is NO memory behind it -- no DRAM, no
+ * MemCtrl, no address mapper: the cache itself is the storage and the tag
+ * lookup is the mapping. Made large (2GiB by default, see the .py) so that
+ * everything the TCC evicts fits.
+ *
+ * It talks ONLY to the TCC:
+ *   reqFromTCC : PUT (park a line, carries data) / GET (take a parked line
+ *                back).                                        CPURequestMsg.
+ *   respToTCC  : WB_ACK for a PUT / DATA for a GET.            ResponseMsg.
+ *
+ * No Sequencer, no mandatoryQueue, no memory port. The cache never overflows
+ * in practice: the TCC's parkedTags registry is the same size as this cache
+ * and the TCC only parks when parkedTags has room (otherwise it evicts a
+ * victim out to CXL first), so a PUT always finds room here. A defensive LRU
+ * drop is kept for safety and warns if it ever triggers.
+ *
+ * Message-type reuse (no new types needed):
+ *   PUT  = CoherenceRequestType:WriteThrough  (carries in_msg.DataBlk)
+ *   GET  = CoherenceRequestType:RdBlk
+ *   ack  = CoherenceResponseType:TDSysWBAck
+ *   data = CoherenceResponseType:TDSysResp
+ */
+
+Addr setMemoryOffset(Addr addr, int offset);
+MachineID mapAddressToMachine(Addr addr, MachineType mtype);
+
+machine(MachineType:BackingCache, "Self-contained tagged cache (TCC parking store, no memory behind)")
+    : CacheMemory * cacheMemory;
+      Cycles cache_response_latency := 4; // TODO: Change to 1
+	  Cycles toHBMLatency := 10;
+	  int offset := 224;
+
+      // To/from the TCC. vnets 12/13 must match the .py setup.
+      MessageBuffer * reqFromTCC, network="From", virtual_network="12", vnet_type="request";
+      MessageBuffer * respToTCC,  network="To",   virtual_network="13", vnet_type="response";
+
+	  MessageBuffer* respFromHBMToL3;
+	  MessageBuffer* reqFromL3ToHBM;
+
+	  bool cacheEnabled;
+{
+  // STATES
+  state_declaration(State, desc="Backing cache states", default="BackingCache_State_I") {
+    I, AccessPermission:Invalid,    desc="Line not parked here";
+    V, AccessPermission:Read_Write, desc="Line parked here";
+
+	I_D, AccessPermission:Busy,		desc="Data is requested from HBM. Waiting for reply";
+  }
+
+  // EVENTS
+  enumeration(Event, desc="Backing cache events") {
+    PUT, desc="TCC parks a line here (carries data)";
+    GET, desc="TCC takes a previously parked line back";
+    INV, desc="TCC drops a parked line (no data, no response)";
+
+	GET_HBM, desc="Data not present, request dir";
+	FWD,     desc="Data arrived, countinue with transient state";
+	EVICT, desc="Buffer full, evict, write to the HBM, and store new data locally";
+  }
+
+  // TYPES
+  structure(Entry, desc="...", interface="AbstractCacheEntry") {
+    State CacheState,  desc="cache state";
+    DataBlock DataBlk, desc="Parked data";
+  }
+
+  // PROTOTYPES
+  Tick clockEdge();
+  void set_cache_entry(AbstractCacheEntry a);
+  void unset_cache_entry();
+
+  Entry getCacheEntry(Addr addr), return_by_pointer="yes" {
+    return static_cast(Entry, "pointer", cacheMemory.lookup(addr));
+  }
+
+  State getState(Entry cache_entry, Addr addr) {
+    if (is_valid(cache_entry)) {
+      return cache_entry.CacheState;
+    }
+    return State:I;
+  }
+
+  void setState(Entry cache_entry, Addr addr, State state) {
+    if (is_valid(cache_entry)) {
+      cache_entry.CacheState := state;
+    }
+  }
+
+  bool cacheLinePresent(Addr addr) {
+	  return cacheMemory.isTagPresent(addr);
+  }
+
+  bool cacheAvail(Addr addr) {
+	  return cacheMemory.cacheAvail(addr);
+  }
+
+  bool cachePresentOrAvail(Addr addr) {
+	  return cacheMemory.isTagPresent(addr) || cacheMemory.cacheAvail(addr);
+  }
+
+  AccessPermission getAccessPermission(Addr addr) {
+    Entry cache_entry := getCacheEntry(addr);
+    if (is_valid(cache_entry)) {
+      return BackingCache_State_to_permission(cache_entry.CacheState);
+    }
+    return AccessPermission:NotPresent;
+  }
+
+  void setAccessPermission(Entry cache_entry, Addr addr, State state) {
+    if (is_valid(cache_entry)) {
+      cache_entry.changePermission(BackingCache_State_to_permission(state));
+    }
+  }
+
+  void functionalRead(Addr addr, Packet *pkt) {
+    testAndRead(addr, getCacheEntry(addr).DataBlk, pkt);
+  }
+
+  int functionalWrite(Addr addr, Packet *pkt) {
+    int num_functional_writes := 0;
+    num_functional_writes := num_functional_writes +
+        testAndWrite(addr, getCacheEntry(addr).DataBlk, pkt);
+    return num_functional_writes;
+  }
+
+  // OUT PORT
+  out_port(respNetwork_out, ResponseMsg, respToTCC);
+  out_port(hbmNetwork_out, MemoryMsg, reqFromL3ToHBM);
+
+  // IN PORT
+  in_port(reqNetwork_in, CPURequestMsg, reqFromTCC) {
+    if (reqNetwork_in.isReady(clockEdge())) {
+      peek(reqNetwork_in, CPURequestMsg, block_on="addr") {
+		Addr addr := in_msg.addr;
+        DPRINTF(RubySlicc, "BACKED[cache] req type=%s addr=%#x from=%s state=%s\n", in_msg.Type, in_msg.addr, in_msg.Requestor, getState(getCacheEntry(addr), in_msg.addr));
+        if (in_msg.Type == CoherenceRequestType:WriteThrough) {
+			if (cacheEnabled && cachePresentOrAvail(addr)) {
+				trigger(Event:PUT, in_msg.addr, getCacheEntry(addr));
+			} else {
+				Addr victim := cacheMemory.cacheProbe(addr);
+				trigger(Event:EVICT, victim, getCacheEntry(victim));
+			}
+        } else if (in_msg.Type == CoherenceRequestType:RdBlk) {
+		  if (cacheLinePresent(addr)) {
+			trigger(Event:GET, addr, getCacheEntry(addr));
+		  } else {
+			trigger(Event:GET_HBM, addr, getCacheEntry(addr));
+		  }
+        } else if (in_msg.Type == CoherenceRequestType:InvCache) {
+          trigger(Event:INV, in_msg.addr, getCacheEntry(addr));
+        } else {
+          error("BackingCache: unexpected request type from TCC");
+        }
+      }
+    }
+  }
+
+  in_port(hbmNetwork_in, CoherenceMessage, respFromHBMToL3) {
+	if (hbmNetwork_in.isReady(clockEdge())) {
+	  peek(hbmNetwork_in, CoherenceMessage) {
+		Addr addr := in_msg.LineAddress;
+		trigger(Event:FWD, addr, getCacheEntry(addr));
+	  }
+	}
+  }	
+
+  // ACTIONS
+  action(a_allocate, "a", desc="Allocate a backing entry (defensive LRU drop if full)") {
+    if (is_invalid(cache_entry)) {
+      //if (cacheMemory.cacheAvail(address) == false) {
+		// Should not happen: parkedTags gating keeps room here. Drop the LRU
+        // victim so we never crash, and warn.
+        //Addr victim := cacheMemory.cacheProbe(address);
+        //DPRINTF(RubySlicc, "BACKED[cache] FULL, dropping victim %#x for %#x\n", victim, address);
+        //cacheMemory.deallocate(victim);
+      //}
+      set_cache_entry(cacheMemory.allocate(address, new Entry));
+    }
+  }
+
+  action(afn_allocateFromNetwork, "afn", desc="Allocate a backing entry (defensive LRU drop if full). Similar to a_allocate, but takes data from network frame") {
+	peek(reqNetwork_in, CPURequestMsg) {
+	  if (is_invalid(getCacheEntry(in_msg.addr))) {
+	    set_cache_entry(cacheMemory.allocate(in_msg.addr, new Entry));
+	  }
+	}
+  }
+  action(r_requestDir, "r", desc="Issues a request to hbm") {
+	enqueue(hbmNetwork_out, MemoryMsg, toHBMLatency) {
+	  out_msg.addr := setMemoryOffset(address, offset); // sets offset. default 0xE0
+	  out_msg.Sender := machineID;
+      out_msg.Type := MemoryRequestType:MEMORY_READ;
+      out_msg.MessageSize := MessageSizeType:Request_Control;
+      out_msg.Len := 0;
+	}
+  }
+
+  action(f_forwardDataToTCC, "f", desc="Forwards a responce message to TCC") {
+	peek(hbmNetwork_in, CoherenceMessage) {
+	  enqueue(respNetwork_out, ResponseMsg, cache_response_latency) {
+		out_msg.addr := setMemoryOffset(address, 0); // removes offset
+		out_msg.Type := CoherenceResponseType:TDSysResp;
+		out_msg.Sender := machineID;
+		out_msg.Destination.add(mapAddressToMachine(address, MachineType:TCC));
+	    out_msg.DataBlk := in_msg.cl;
+	    out_msg.MessageSize := MessageSizeType:Response_Data;
+	  }
+	}
+  }
+
+  action(w_writeData, "w", desc="Store the parked data") {
+    peek(reqNetwork_in, CPURequestMsg) {
+      assert(is_valid(cache_entry));
+      cache_entry.DataBlk := in_msg.DataBlk;
+      cacheMemory.setMRU(in_msg.addr);
+    }
+  }
+
+  action(ack_sendAck, "ack", desc="Ack the PUT back to the TCC") {
+    peek(reqNetwork_in, CPURequestMsg) {
+      DPRINTF(RubySlicc, "BACKED[cache] send WB_ACK addr=%#x to=%s\n", address, in_msg.Requestor);
+      enqueue(respNetwork_out, ResponseMsg, cache_response_latency) {
+        out_msg.addr := in_msg.addr;
+        out_msg.Type := CoherenceResponseType:TDSysWBAck;
+        out_msg.Sender := machineID;
+        out_msg.Destination.add(in_msg.Requestor);
+        out_msg.MessageSize := MessageSizeType:Writeback_Control;
+      }
+    }
+  }
+
+  action(d_sendData, "d", desc="Return the parked line to the TCC on GET") {
+    peek(reqNetwork_in, CPURequestMsg) {
+      DPRINTF(RubySlicc, "BACKED[cache] send DATA addr=%#x to=%s\n", address, in_msg.Requestor);
+      enqueue(respNetwork_out, ResponseMsg, cache_response_latency) {
+        assert(is_valid(cache_entry));
+        out_msg.addr := address;
+        out_msg.Type := CoherenceResponseType:TDSysResp;
+        out_msg.Sender := machineID;
+        out_msg.Destination.add(in_msg.Requestor);
+        out_msg.DataBlk := cache_entry.DataBlk;
+        out_msg.MessageSize := MessageSizeType:Response_Data;
+      }
+    }
+  }
+
+  action(i_deallocate, "i", desc="Free the backing entry") {
+    if (is_valid(cache_entry)) {
+      cacheMemory.deallocate(address);
+      unset_cache_entry();
+    }
+  }
+
+  action(p_popRequest, "p", desc="Pop the TCC request queue") {
+    reqNetwork_in.dequeue(clockEdge());
+  }
+
+  action(pd_popResponceDir, "pd", desc="Pop the DIR response queue") {
+	hbmNetwork_in.dequeue(clockEdge());
+  }
+
+  action(sed_sendEvictedData, "sed", desc="Send data that was evicted to the HBM") {
+	enqueue(hbmNetwork_out, MemoryMsg, toHBMLatency) {
+	  out_msg.addr := setMemoryOffset(address, offset);
+	  out_msg.Sender := machineID;
+      out_msg.Type := MemoryRequestType:MEMORY_WB;
+      out_msg.MessageSize := MessageSizeType:Writeback_Data;
+	  out_msg.DataBlk := cache_entry.DataBlk;
+      out_msg.Len := 0;
+	}
+  }
+
+  // TRANSITIONS
+
+  // PUT: park the line (overwrite if already present).
+  transition({I, V}, PUT, V) {
+    a_allocate;
+    w_writeData;
+    ack_sendAck;
+    p_popRequest;
+  }
+
+  // GET: return the line to the TCC and free the slot (the TCC takes it back
+  // into its L2; keeps this cache in sync with parkedTags).
+  transition(V, GET, I) {
+    d_sendData;
+    i_deallocate;
+    p_popRequest;
+  }
+
+  // Stays invalid as data will be forwarded to the TCC 
+  transition(I, GET_HBM, I_D) {
+    r_requestDir;
+  }
+
+  // INV: TCC drops a parked line without taking it back (e.g. an InvCache probe
+  // on a present-class parked line). Fire-and-forget: free the slot, no
+  // response. Tolerated on I too, in case the line was already reclaimed.
+  transition({I, V}, INV, I) {
+    i_deallocate;
+    p_popRequest;
+  }
+
+  // handle transient state
+  transition(I_D, FWD, I) {
+	f_forwardDataToTCC;
+	pd_popResponceDir;
+  }
+
+  // Evict only in invalid state as, if data is present then it will be overwritten in PUT
+  transition(I, EVICT, I) {
+	sed_sendEvictedData;
+	afn_allocateFromNetwork;
+	w_writeData;
+	ack_sendAck;
+	p_popRequest;
+  }
+
+}
