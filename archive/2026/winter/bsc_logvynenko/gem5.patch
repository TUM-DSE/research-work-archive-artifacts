+  // Reserve the parkedTags slot at PARK time -- i.e. synchronously with the
+  // L2_Repl admission decision taken in coreRequestNetwork_in -- rather than
+  // later, when the backing ack arrives (rp_registerParked). trigger()/
+  // doTransition run synchronously, so the slot is taken in the very same
+  // wakeup that just checked parkedTags.cacheAvail(victim). This closes the
+  // TOCTOU window that used to let two concurrent parks mapping to the same
+  // set both pass admission against a single free way and then overflow the
+  // second one's allocate() in rp_registerParked (assert cacheAvail failed).
+  //
+  // No set_cache_entry() here on purpose: the machine's cache_entry must stay
+  // the (about-to-be-invalidated) L2 entry so that i_invL2 and the end-of-
+  // transition setState keep operating on L2, never on this parkedTags entry.
+  action(rpp_reserveParked, "rpp", desc="reserve the parkedTags slot up-front at park time") {
+    assert(is_valid(tbe));
+    if (parkedTags.isTagPresent(address) == false) {
+      parkedTags.allocate(address, new Entry);
+    }
+    Entry pe := static_cast(Entry, "pointer", parkedTags.lookup(address));
+    pe.CacheState := tbe.parkedClass;
+    // pe.writeMask records which bytes of the parked copy are VALID. Every
+    // class except M__C__IP parks a full line; M__C__IP (partial GLC store
+    // diverted to the backing) only has the stored bytes.
+    if (tbe.parkedClass == State:M__C__IP) {
+      pe.writeMask.clear();
+      pe.writeMask.orMask(tbe.writeMask);
+    } else {
+      pe.writeMask.fillMask();
+    }
+  }
+
+  action(rp_registerParked, "rp", desc="finalize the parked registration on backing ack") {
