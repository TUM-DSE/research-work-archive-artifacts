+)
+parser.add_argument(
+    "--cpu-to-dir-bw-factor",
+    type=int,
+    default=0,
+    help="Ruby bandwidth_factor of the CPU<->memory link. In SE mode a "
+    "host-side hipMemcpy is a CPU memcpy travelling this link, so this is the "
+    "knob that models the PCIe/CXL bandwidth of the copy, independently of "
