+// doorbell from a CPU thread while a GPU kernel is resident.
+//
+// Two pages is also what the hardware has: Vega's doorbell aperture is 8 KiB.
+static const Addr HSAPP_DOORBELL_APERTURE = 2 * PAGE_SIZE;
+
