+
+        sqc_cntrl.probeToSQC = MessageBuffer(ordered=True)
+        sqc_cntrl.probeToSQC.in_port = network.out_port
+
+        sqc_cntrl.responseToSQC = MessageBuffer(ordered=True)
+        sqc_cntrl.responseToSQC.in_port = network.out_port
