+      a_allocateBlock;
+      t_allocateTBE;
+      ut_updateTag;
+      mrs_MemRdS;
+      p_popRequestQueue;
+    }
+    transition(I__C__IS, CmpE, I__C__IE_CmpE) {TagArrayRead} {
+      pndr_popNDRFromIn;
+      wada_wakeUpAllDependentsAddr; // If we got data early, wake up dependents
+    }
+    transition(I__C__IE_CmpE, Data, I__C__E) {TagArrayRead, TagArrayWrite, DataArrayWrite} {
