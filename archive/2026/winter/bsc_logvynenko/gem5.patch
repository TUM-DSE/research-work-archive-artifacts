+    "--gpu-to-dir-bw-factor",
+    type=int,
+    default=0,
+    help="Ruby bandwidth_factor of the GPU<->memory link, i.e. the CXL link. "
+    "Unlike --bw-scalor this only throttles the interconnect, with no side "
+    "effect on TCC size or banking. 0 disables it (fall back to --bw-scalor "
+    "or the default link).",
+)
+parser.add_argument(
+    "--fabric-bw-factor",
+    type=int,
+    default=0,
+    help="Ruby bandwidth_factor for every link that is not the GPU<->memory "
+    "one: the GPU-internal fabric, the directory links and the CPU side. Pass "
+    "the anchor factor here so --gpu-to-dir-bw-factor sweeps the CXL link alone. "
