+  action(lpc_loadParkClassToTBE, "lpc", desc="load a parked line's class into the TBE") {
+    assert(is_valid(tbe));
+    assert(parkedTags.isTagPresent(address));
+    Entry pe := static_cast(Entry, "pointer", parkedTags.lookup(address));
+    tbe.parkedClass := pe.CacheState;
+    // Recover the valid-bytes mask recorded at park time (full for every
+    // class except a partial M__C__IP store-park). Consumed by the merge
+    // actions (mrgd_mergeMemData, wdbr_writeDirtyBytesResp) downstream.
+    tbe.writeMask.clear();
+    tbe.writeMask.orMask(pe.writeMask);
+  }
