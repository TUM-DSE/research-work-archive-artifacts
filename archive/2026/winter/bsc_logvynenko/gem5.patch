@@ -0,0 +1,8685 @@
+//Backend.SLICC.ModularSLICC.proxy.GenProxyHeader
+machine(MachineType:L0Cache, "Proxy cache controller")
+: CacheMemory *cache;
+
+  // The following latencies should be exposed as command-line parameters in a future update
