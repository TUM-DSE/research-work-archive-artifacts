+def create_system(
+    options, full_system, system, dma_devices, bootmem, ruby_system, cpus
+):
+    if buildEnv["PROTOCOL"] != "GPU_VIPER_CXL_MESIF":
+        panic("This script requires the GPU_VIPER_CXL_MESIF protocol to be built.")
+
+    cpu_sequencers = []
+
+    #
+    # Must create the individual controllers before the network to ensure the
+    # controller constructors are called before the network constructor
+    #
+
+    # This is the base crossbar that connects the L3s, Dirs, and cpu/gpu
+    # Clusters
+    crossbar_bw = None
+    mainCluster = None
+    cpuCluster = None
+    gpuCluster = None
+
+    if hasattr(options, "gpu_to_dir_bw_factor") and options.gpu_to_dir_bw_factor > 0:
+        # Each link gets its own bandwidth, named after the two endpoints it
+        # connects, so that a sweep of one link leaves the others untouched:
+        #
+        #   gpu_to_dir_bw   GPU  <-> system (CXL) memory   [gpuCluster ext]
+        #   cpu_to_dir_bw   CPU  <-> system (CXL) memory   [cpuCluster ext]
+        #   fabric_bw       everything on-chip: the GPU-internal crossbar, the
+        #                   directory links and the cluster interiors. Kept
+        #                   above the memory bandwidths so it never binds.
+        #
+        # With --dgpu the GPU-local memory is NOT reached over gpu_to_dir_bw:
+        # it hangs off its own sub-cluster further down, see gpuMemCluster.
+        gpu_to_dir_bw = options.gpu_to_dir_bw_factor
+        fabric_bw = getattr(options, "fabric_bw_factor", 0)
+        if fabric_bw <= 0:
+            fabric_bw = gpu_to_dir_bw
+        cpu_to_dir_bw = getattr(options, "cpu_to_dir_bw_factor", 0)
+        if cpu_to_dir_bw <= 0:
+            cpu_to_dir_bw = fabric_bw
+        mainCluster = Cluster(intBW=fabric_bw)
+        cpuCluster = Cluster(extBW=cpu_to_dir_bw, intBW=fabric_bw, extLatency=options.cpu_to_dir_latency)
+        gpuCluster = Cluster(extBW=gpu_to_dir_bw, intBW=fabric_bw, extLatency=options.gpu_to_dir_latency)
+    elif hasattr(options, "bw_scalor") and options.bw_scalor > 0:
+        # Assuming a 2GHz clock
+        crossbar_bw = 16 * options.num_compute_units * options.bw_scalor
+        mainCluster = Cluster(intBW=crossbar_bw)
+        cpuCluster = Cluster(extBW=crossbar_bw, intBW=crossbar_bw, extLatency=options.cpu_to_dir_latency)
+        gpuCluster = Cluster(extBW=crossbar_bw, intBW=crossbar_bw, extLatency=options.gpu_to_dir_latency)
+    else:
+        mainCluster = Cluster(intBW=8)  # 16 GB/s
+        cpuCluster = Cluster(extBW=8, intBW=8, extLatency=options.cpu_to_dir_latency)  # 16 GB/s
+        gpuCluster = Cluster(extBW=1, intBW=8, extLatency=options.gpu_to_dir_latency)  # 16 GB/s
+
+    # Create CPU directory controllers
+    dir_cntrl_nodes = construct_dirs(
+        options, system, ruby_system, ruby_system.network
+    )
+    for dir_cntrl in dir_cntrl_nodes:
+        mainCluster.add(dir_cntrl)
+
+    if options.dgpu:
+        #remote_mem_range = AddrRange(start=Addr(options.mem_size), size=options.dgpu_mem_size)
+        #system.mem_ranges.append(remote_mem_range)
+        # Construct GPU memories
+        (gpu_dir_cntrl_nodes, gpu_mem_ctrls) = construct_gpudirs(
+            options, system, ruby_system, ruby_system.network
+        )
+        # Give the local memory its own sub-cluster so that its access
+        # latency can be modelled: a nested Cluster is attached with an
+        # IntLink that honours extLatency, whereas a bare controller is
+        # attached with an ExtLink that does not. Setting intLatency on
+        # gpuCluster instead would slow down every TCP/SQC/TCC link too.
+        # extBW is left at 0 so the link keeps gpuCluster's intBW.
+        local_mem_latency = getattr(options, "gpu_to_local_mem_latency", 0)
+        if local_mem_latency > 0:
+            # Two different links are configured here and both need a value:
+            #  - extBW/extLatency describe the GPU <-> local-memory link
+            #    itself (the IntLink up to gpuCluster's router);
+            #  - intBW describes the links from each local directory down
+            #    to this sub-cluster's router. Leaving intBW at 0 makes
+            #    those fall back to BasicLink's default bandwidth_factor of
+            #    16, throttling the local memory ~85x.
+            local_mem_bw = getattr(options, "gpu_to_local_mem_bw_factor", 0)
+            if local_mem_bw <= 0:
+                local_mem_bw = gpuCluster.intBW
+            gpuMemCluster = Cluster(
+                # extBW/extLatency describe the GPU <-> local-memory link
+                # itself; intBW describes the links from each local directory
+                # down to this sub-cluster's router. Leaving intBW at 0 would
+                # drop those to BasicLink's default bandwidth_factor of 16.
+                intBW=gpuCluster.intBW,
+                extBW=local_mem_bw,
+                extLatency=local_mem_latency,
+            )
+            for dir_cntrl in gpu_dir_cntrl_nodes:
+                gpuMemCluster.add(dir_cntrl)
+            gpuCluster.add(gpuMemCluster)
+        else:
+            for dir_cntrl in gpu_dir_cntrl_nodes:
+                gpuCluster.add(dir_cntrl)
+
+    # Create CPU L1s
+    (cp_sequencers, cp_cntrl_nodes) = construct_l1s(
+        options, system, ruby_system, ruby_system.network
+    )
+    cpu_sequencers.extend(cp_sequencers)
+    for cp_cntrl in cp_cntrl_nodes:
+        cpuCluster.add(cp_cntrl)
+
+    # Create CPU LLC
+    l2_cntrl = construct_l2(system, ruby_system, 0, options)
+    cpuCluster.add(l2_cntrl)
+
+    # Register CPUs and caches for each CorePair and directory (SE mode only)
+    if not full_system:
+        for i in range(options.num_cpus):
+            FileSystemConfig.register_cpu(
+                physical_package_id=0,
+                core_siblings=range(options.num_cpus),
+                core_id=i,
+                thread_siblings=[],
+            )
+
+            FileSystemConfig.register_cache(
+                level=0,
+                idu_type="Data",
+                size=options.l1d_size,
+                line_size=options.cacheline_size,
+                assoc=options.l1d_assoc,
+                cpus=[i],
+            )
+
+        for i in range(options.num_dirs):
+            FileSystemConfig.register_cache(
+                level=2,
+                idu_type="Unified",
+                size=options.l3_size,
+                line_size=options.cacheline_size,
+                assoc=options.l3_assoc,
+                cpus=[n for n in range(options.num_cpus)],
+            )
+
+    # Create TCPs
+    (tcp_sequencers, tcp_cntrl_nodes) = construct_tcps(
+        options, system, ruby_system, ruby_system.network
+    )
+    cpu_sequencers.extend(tcp_sequencers)
+    for tcp_cntrl in tcp_cntrl_nodes:
+        gpuCluster.add(tcp_cntrl)
+
+    # Create SQCs
+    (sqc_sequencers, sqc_cntrl_nodes) = construct_sqcs(
+        options, system, ruby_system, ruby_system.network
+    )
+    cpu_sequencers.extend(sqc_sequencers)
+    for sqc_cntrl in sqc_cntrl_nodes:
+        gpuCluster.add(sqc_cntrl)
+
+    # Create Scalars
+    (scalar_sequencers, scalar_cntrl_nodes) = construct_scalars(
+        options, system, ruby_system, ruby_system.network
+    )
+    cpu_sequencers.extend(scalar_sequencers)
+    for scalar_cntrl in scalar_cntrl_nodes:
+        gpuCluster.add(scalar_cntrl)
+
+    # Create command processors
+    (cmdproc_sequencers, cmdproc_cntrl_nodes) = construct_cmdprocs(
+        options, system, ruby_system, ruby_system.network
+    )
+    cpu_sequencers.extend(cmdproc_sequencers)
+    for cmdproc_cntrl in cmdproc_cntrl_nodes:
+        gpuCluster.add(cmdproc_cntrl)
+
+    # Create TCCs
+    tcc_cntrl_nodes = construct_tccs(
+        options, system, ruby_system, ruby_system.network
+    )
+    for tcc_cntrl in tcc_cntrl_nodes:
+        gpuCluster.add(tcc_cntrl)
+
+    for i, dma_device in enumerate(dma_devices):
+
+        dma_seq = DMASequencer(version=i, ruby_system=ruby_system)
+        dma_cntrl = GPU_VIPER_CXL_MESIF_DMA_Controller(
+            version=i, dma_sequencer=dma_seq, ruby_system=ruby_system
+        )
+        exec("system.dma_cntrl%d = dma_cntrl" % i)
+
+        # IDE doesn't have a .type but seems like everything else does.
+        if not hasattr(dma_device, "type"):
+            exec("system.dma_cntrl%d.dma_sequencer.in_ports = dma_device" % i)
+        elif dma_device.type == "MemTest":
+            exec(
+                "system.dma_cntrl%d.dma_sequencer.in_ports = dma_devices.test"
+                % i
+            )
+        else:
+            exec(
+                "system.dma_cntrl%d.dma_sequencer.in_ports = dma_device.dma"
+                % i
+            )
+
+        dma_cntrl.requestToDir = MessageBuffer(buffer_size=0)
+        dma_cntrl.requestToDir.out_port = ruby_system.network.in_port
+        dma_cntrl.responseFromDir = MessageBuffer(buffer_size=0)
+        dma_cntrl.responseFromDir.in_port = ruby_system.network.out_port
+        dma_cntrl.mandatoryQueue = MessageBuffer(buffer_size=0)
+        gpuCluster.add(dma_cntrl)
+
+    # Add cpu/gpu clusters to main cluster
+    mainCluster.add(cpuCluster)
+    mainCluster.add(gpuCluster)
+
+
+    ruby_system.network.number_of_virtual_networks = 17
+
+    return (cpu_sequencers, dir_cntrl_nodes, mainCluster)
