+        out_msg.addr := address;
+        out_msg.Type := CoherenceRequestType:InvCache;   // DROP (no data, no resp)
+        out_msg.Requestor := machineID;
+        out_msg.Destination.add(mapAddressToMachine(address, MachineType:BackingCache));
+        out_msg.MessageSize := MessageSizeType:Control;
+      }
+      parkedTags.deallocate(address);
+    }
+  }
