+    parser.add_argument("--gpu-to-local-mem-latency", type=int, default=0,
+                        help="latency from the GPU to its own local memory "
+                             "(--dgpu only). The local directories sit inside "
+                             "the GPU cluster, so --gpu-to-dir-latency does not "
+                             "reach them: it describes the link towards CXL. "
+                             "0 keeps them on the plain intra-cluster link.")
+    parser.add_argument("--gpu-to-local-mem-bw-factor", type=int, default=0,
+                        help="Ruby bandwidth_factor of the GPU <-> local memory "
+                             "link (--dgpu only), i.e. the HBM bandwidth. Pairs "
+                             "with --gpu-to-local-mem-latency the same way "
+                             "--gpu-to-dir-bw-factor pairs with "
+                             "--gpu-to-dir-latency. 0 makes the link inherit "
+                             "--fabric-bw-factor, which leaves the local memory "
+                             "effectively unthrottled.")
