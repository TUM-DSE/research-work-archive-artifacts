+  action(spcM_setDirty, "spcM", desc="park class = dirty") {
+    assert(is_valid(tbe));
+    tbe.parkedClass := State:I__C__M;
+    tbe.Dirty := true;
+  }
+  action(spcS_setClean, "spcS", desc="park class = clean") {
+    assert(is_valid(tbe));
+    tbe.parkedClass := State:I__C__S;
+    tbe.Dirty := false;
+  }
+  action(spcP_setPresent, "spcP", desc="park class = present") {
+    assert(is_valid(tbe));
+    tbe.parkedClass := State:V__C__P;
+  }
+  // M__C__P: dirty LOCALLY but the CXL directory does NOT own the line (it was
+  // obtained via SnpCur, dir is in S/I). Keep the data (Dirty=true) so it is
+  // preserved in the backing, but tag it with its own class so that on refill
+  // it is restored as M__C__P (answers a BISnp with BIRspI, never MemWr_IL2)
+  // and on overflow it is flushed via GetM+MemWr, never a raw owner writeback.
+  action(spcMP_setPresentDirty, "spcMP", desc="park class = M__C__P (dirty, not dir-owned)") {
+    assert(is_valid(tbe));
+    tbe.parkedClass := State:M__C__P;
+    tbe.Dirty := true;
+  }
+  // GLC store diverted to the backing from I__C__I (ST_GLC_Park). If the store
+  // covers the whole line it is indistinguishable from a resident M__C__P park
+  // (class M__C__P, full validity). A PARTIAL store gets its own class tag,
+  // M__C__IP (reusing that State value as a tag, like the others): only the
+  // tbe.writeMask bytes are valid, so refill/overflow must first fetch the
+  // memory background and merge before the line can be reinstalled/flushed.
+  action(spcST_setStoreParkClass, "spcST", desc="park class for a diverted GLC store: M__C__P if full-line, M__C__IP if partial") {
+    assert(is_valid(tbe));
+    if (tbe.writeMask.isFull()) {
