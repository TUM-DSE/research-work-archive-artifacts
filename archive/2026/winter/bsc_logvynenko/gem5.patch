+)
+parser.add_argument(
+    "--dgpu-mem-size",
+    action="store",
+    type=str,
+    #default="16GiB",
+    default="8GiB",
+    #default="128MiB",
+    help="Specify the dGPU physical memory size",
+)
+
 # Mtype option
 # --     1   1   1   C_RW_S  (Cached-ReadWrite-Shared)
 # --     1   1   0   C_RW_US (Cached-ReadWrite-Unshared)
@@ -490,6 +589,35 @@ args.num_sqc = num_sqc  # pass this to Ruby
 num_scalar_cache = int(math.ceil(float(n_cu) / args.cu_per_scalar_cache))
 args.num_scalar_cache = num_scalar_cache
 
+# Scale the GPU caches with wavefront occupancy, using the Radeon VII as the
+# reference point: 60 CU x 4 SIMD x 10 wf-slots = 2400 wf-slots, 16KiB L1 per
+# CU and a 4MiB LLC, i.e. 409.6 B per wf-slot for the per-CU L1 and 1747.6 B
+# per wf-slot for the aggregate LLC. Ruby cache sizes must be powers of two.
+if args.wf_cache_scaling:
+
+    def round_pow2(nbytes):
+        nbytes = max(1.0, float(nbytes))
+        low = 2 ** int(math.floor(math.log2(nbytes)))
+        high = low * 2
+        return int(high if (high - nbytes) < (nbytes - low) else low)
+
+    def format_size(nbytes):
+        if nbytes % 1024 == 0:
+            return "%dKiB" % (nbytes // 1024)
+        return "%dB" % nbytes
+
+    wf_slots_per_cu = args.simds_per_cu * args.wfs_per_simd
+    args.tcp_size = format_size(round_pow2(409.6 * wf_slots_per_cu))
+    args.tcc_size = format_size(round_pow2(1747.6 * n_cu * wf_slots_per_cu))
+    print(
+        "Wavefront-scaled caches: wfs_per_simd =",
+        args.wfs_per_simd,
+        "TCP =",
+        args.tcp_size,
+        "TCC =",
+        args.tcc_size,
+    )
+
 print(
     "Num SQC = ",
     num_sqc,
@@ -518,7 +646,7 @@ shader = Shader(
 # means pipeline initiates a acquire/release operation at kernel launch/end.
 # VIPER protocol is write-through based, and thus only impl_kern_launch_acq
 # needs to set.
-if buildEnv["PROTOCOL"] == "GPU_VIPER":
+if buildEnv["PROTOCOL"] == "GPU_VIPER" or buildEnv["PROTOCOL"] == "GPU_VIPER_CXL_MESIF" or buildEnv["PROTOCOL"] == "GPU_VIPER_CXL_MESIF_BACKED":
     shader.impl_kern_launch_acq = True
     shader.impl_kern_end_rel = False
 else:
@@ -689,6 +817,11 @@ if fast_forward:
                 voltage_domain=VoltageDomain(voltage=args.cpu_voltage),
             ),
         )
+        # Inside Docker perf_event_open is blocked by seccomp, so the KVM CPU
+        # fails with "PerfKvmCounter::attach failed". We fast-forward on the
+        # m5_switch_cpu() pseudo-op and never need perf-based instruction
+        # counting, so turn the hardware counters off.
+        cpu.usePerf = False
         cpu_list.append(cpu)
 
         if args.fast_forward:
@@ -729,7 +862,8 @@ host_cpu = cpu_list[0]
 
 hsapp_gpu_map_vaddr = 0x200000000
 hsapp_gpu_map_size = 0x1000
-hsapp_gpu_map_paddr = int(Addr(args.mem_size))
+#hsapp_gpu_map_paddr = int(Addr(args.mem_size))
+hsapp_gpu_map_paddr = int(Addr(args.mem_size)) + int(Addr(args.dgpu_mem_size))
 
 if args.dgpu:
     # Default --m-type for dGPU is write-back gl2 with system coherence
@@ -739,11 +873,14 @@ if args.dgpu:
 
 # HSA kernel mode driver
 # dGPUPoolID is 0 because we only have one memory pool
+dgpu_pool_id = 0
+if args.dgpu:
+    dgpu_pool_id = 1
 gpu_driver = GPUComputeDriver(
     filename="kfd",
     isdGPU=args.dgpu,
     gfxVersion=args.gfx_version,
-    dGPUPoolID=0,
+    dGPUPoolID=dgpu_pool_id,
     m_type=args.m_type,
 )
 
@@ -855,9 +992,12 @@ cpu_list = cpu_list + [shader] + cp_list
 
 # creating the overall system
 # notice the cpu list is explicitly added as a parameter to System
+phys_mem_ranges = [AddrRange(args.mem_size)]
+if args.dgpu:
+    phys_mem_ranges.append(AddrRange(start=Addr(args.mem_size), size=args.dgpu_mem_size))
 system = System(
     cpu=cpu_list,
-    mem_ranges=[AddrRange(args.mem_size)],
+    mem_ranges=phys_mem_ranges,
     cache_line_size=args.cacheline_size,
     mem_mode=mem_mode,
     workload=SEWorkload.init_compatible(executable),
@@ -891,6 +1031,8 @@ system.piobus = IOXBar(
 )
 dma_list = [gpu_hsapp, gpu_cmd_proc]
 Ruby.create_system(args, None, system, None, dma_list, None)
+if args.ruby_randomization:
+    system.ruby.randomization = True
 system.ruby.clk_domain = SrcClockDomain(
     clock=args.ruby_clock, voltage_domain=system.voltage_domain
 )
@@ -1075,12 +1217,12 @@ while True:
         break
     elif "GPU Kernel Completed" in exit_event.getCause():
         print("GPU Kernel Completed dump and reset")
-        m5.stats.dump()
-        m5.stats.reset()
